<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mail.mobile.push</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="user_default_rights" position="after">
                <div id="mobile_settings" groups="base.group_no_one">
                    <block title="Mobile Push">
                        <setting help="Receive notifications on Android">
                            <field name="enable_push"/>
                        </setting>
                    </block>
                </div>
            </block>
        </field>
    </record>
</odoo>
